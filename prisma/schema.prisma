generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ====================
// ENUMS
// ====================

enum UserRole {
  admin
}

enum ReservationStatus {
  pending
  approved
  rejected
  cancelled
}

// ====================
// CATEGORY
// ====================

model Category {
  categoryId String   @id @default(uuid()) @db.Uuid
  name       String   @db.VarChar(100)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sweets Sweet[]
}

// ====================
// SWEET
// ====================

model Sweet {
  sweetId     String   @id @default(uuid()) @db.Uuid
  categoryId  String   @db.Uuid
  name        String   @db.VarChar(150)
  description String?
  price       Decimal  @db.Decimal(10, 2)
  imageUrl    String?  @db.VarChar(255)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category Category @relation(fields: [categoryId], references: [categoryId])

  promotions Promotion[]

  @@index([categoryId])
}

// ====================
// PROMOTION
// ====================

model Promotion {
  promotionId        String    @id @default(uuid()) @db.Uuid
  sweetId            String?   @db.Uuid
  discountPercentage Decimal?  @db.Decimal(5, 2)
  validFrom          DateTime? @db.Date
  validTo            DateTime? @db.Date
  isActive           Boolean?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  sweet Sweet? @relation(fields: [sweetId], references: [sweetId])

  reservations Reservation[]

  @@index([sweetId])
}

// ====================
// USER
// ====================

model User {
  userId       String   @id @default(uuid()) @db.Uuid
  username     String   @unique @db.VarChar(50)
  passwordHash String   @db.VarChar(255)
  role         UserRole
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  reservations Reservation[]
  reviews      Review[]
}

// ====================
// RESERVATION
// ====================

model Reservation {
  reservationId   String            @id @default(uuid()) @db.Uuid
  userId          String?           @db.Uuid
  promotionId     String?           @db.Uuid
  guestName       String            @db.VarChar(100)
  phoneNumber     String            @db.VarChar(20)
  reservationDate DateTime          @db.Date
  reservationTime DateTime          @db.Time
  numberOfGuests  Int
  description     String?
  status          ReservationStatus @default(pending)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user User? @relation(fields: [userId], references: [userId])

  promotion Promotion? @relation(fields: [promotionId], references: [promotionId])

  reviews Review[]

  @@index([userId])
  @@index([promotionId])
}

// ====================
// REVIEW
// ====================

model Review {
  reviewId      String   @id @default(uuid()) @db.Uuid
  reservationId String   @db.Uuid
  userId        String?  @db.Uuid
  rating        Int
  comment       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  reservation Reservation @relation(fields: [reservationId], references: [reservationId])

  user User? @relation(fields: [userId], references: [userId])

  @@index([reservationId])
  @@index([userId])
}

// ====================
// ANNOUNCEMENT
// ====================

model Announcement {
  announcementId String   @id @default(uuid()) @db.Uuid
  title          String   @db.VarChar(255)
  content        String
  isVisible      Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
